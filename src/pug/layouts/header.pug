mixin header(props = {})
    -
        var {
            tag = 'header',
        } = props

    #{tag}.header()
        .header__container
            .header__logo
                a(href='#')
                    img(src='../../icons/logo-black.svg' alt='Logo')
            nav.header__nav
                ul.header__menu
                    li.header__menu-item
                        a(href='#') О платформе
                    li.header__menu-item
                        a(href='#') Мероприятия
                    li.header__menu-item
                        a(href='#') Новости
                    li.header__menu-item
                        a(href='#') Образовательные материалы
                    li.header__menu-item
                        a(href='#') Вопросы
                    li.header__menu-item
                        a(href='#') Контакты
            .header__user
                a(href='#')
                    img(src='../../icons/user.svg' alt='User')

            .header__mobile-menu
                button.header__mobile-menu-toggle
                        i.icon.icon-menu
                ul.header__mobile-menu-list
                        li.header__mobile-menu-item.lk
                            a(href='#') Личный кабинет
                            img(src='../../icons/person.svg' alt='User')
                        li.header__mobile-menu-item
                            a(href='#') Университет
                        li.header__mobile-menu-item
                            a(href='#') Точка кипения
                        li.header__mobile-menu-item
                            a(href='#') Новости
                        li.header__mobile-menu-item
                            a(href='#') Образовательные материалы
                        li.header__mobile-menu-item
                            a(href='#') Вопросы
                        li.header__mobile-menu-item
                            a(href='#') Контакты