extends ../layouts/base-layout

include ../components/Button/index
include ../components/Headline/index
include ../components/MenuItem/index
include ../components/ArrowButton/index
include ../components/IconButton/index
include ../components/FlexButton/index
include ../components/CloseMobile/index
include ../components/Alert/index
include ../components/File/index
include ../components/Tab/index
include ../components/Link/index
include ../components/Pagination/index
include ../components/Tag/index
include ../components/Accordion/index
include ../components/EventCard/index
include ../components/NewsCard/index
include ../components/EducationalMaterials/index
include ../components/GraduateCard/index
include ../components/TextContent/index
include ../components/Select/index
include ../layouts/header
include ../layouts/footer

block variables
    - var title = 'EXAMPLE'

block content
    +header()
    main.main
        .container
        h1!= title

        .example-container(style="display: flex; flex-wrap: wrap; gap: 2rem;")
        //- Кнопки
        .column(style="flex: 1; ")
            h4 Buttons
            +button Example
            +button({contrast: true}) Example
            +button({outlined: true}) Example
            +button({isDisabled: true}) Example

        //- Заголовки
        .column(style="flex: 1; ")
            h4 Headlines
            +headline({ iconName: 'button' }) ExampleExampleExampleExampleExampleExample
            +headline({ iconName: 'arrow', isDisabled: true }) Example

        //- Меню
        .column(style="flex: 1; ")
            h4 Menu
            +menuItem({ iconName: 'icon-right' }) Menu Item

        //- Стрелочные кнопки
        .column(style="flex: 1; ")
            h4 Arrow Buttons
            +arrowButton()
            +arrowButton({ light: true })
            +arrowButton({ contrast: true })
            +arrowButton({ isDisabled: true })
            +arrowButton({ light: true, isDisabled: true })
            +arrowButton({ contrast: true, isDisabled: true })

        //- Файлы
        .column(style="flex: 1; ")
            h4 Files
            +actionButton({ type: 'bookmark' })
            +actionButton({ type: 'play' })
            +file('PDF', '99.9KB', { tag: 'div' })
                | File

        //- Flex Buttons, Close Mobile
        .column(style="flex: 1; ")
            h4 Flex Buttons, Close Mobile
            +flexButton({ iconNameLeft: 'arrow-up-left', iconNameRight: 'arrow-up-right' }) Button Text
            +flexButton({ iconNameLeft: 'arrow-up-left' }) Button Text
            +flexButton({ iconNameRight: 'arrow-right' }) Button Text
            +flexButton() Button Text
            +flexButton({ isDisabled: true }) Disabled Button
            +closeMobile()

        //- Алерты
        .column(style="flex: 1; ")
            h4 Alerts
            +alert({ type: 'success' })
                | This is a success alert
            +alert({ type: 'error' })
                | This is an error alert

        //- Табы и пагинация
        .column(style="flex: 1; ")
            h4 Tabs, Pagination
            +tab({ tag: 'button' })
                | Link Tab
            +pagination({ type: 'number' })
                | 1
            +pagination({ type: 'icon' })
            +pagination({ type: 'icon', isDisabled: true })

        //- Ссылки и теги
        .column(style="flex: 1; ")
            h4 Links, Tags
            +link({ type: 'text', size: 's' })
                | Read more
            +link({ type: 'text', size: 'l' })
                | Read more
            +link({ type: 'icon', size: 'l' })
                | Download file
            +link({ type: 'social', size: 'l' })
                | Download file
            +tag({ type: 'educational-materials', color: 'parenting' })
                | Parenting Tag
        .column(style="flex: 1;     background-color: var(--gray-color-2);")
            h4 Accordion
            +accordion({ title: 'Как зарегистрироваться на сайте?', isExpanded: false })
                //- p Для регистрации перейдите на страницу входа и заполните форму.
            +accordion({ title: 'Как восстановить пароль?', isExpanded: true })
                p Нажмите на ссылку "Забыли пароль?" и следуйте инструкциям.
        .column(style="flex: 1; background-color: var(--gray-color-2);")
            h4 Event card
            +eventCard({
                title: 'Название мероприятия',
                date: { day: '03', month: '05', year: '2025' },
                infoItems: [
                { icon: 'clock', text: '12:00 - 18:00' },
                { icon: 'map-pin', text: 'ГУАП, Ленсоветова 14, актовый зал' },
                { icon: 'users-group', text: '500 человек' }
                ],
                tags: [{ type: 'educational-materials', color: 'parenting', label: 'Наука' },
                { type: 'educational-materials', color: 'parenting', label: 'Наука' },
                ]
            })
        .column(style="flex: 1; background-color: var(--gray-color-2);")
            h4 News card
            +newsCard({
                title: 'Заголовок H4',
                date: '31 октября',
                location: 'Университет'
            })
        .column(style="flex: 1; background-color: var(--gray-color-2);")
            h4 Educational Materials Card
            +educationalMaterials({
                tag: 'Внеучебные',
                title: 'Образовательный материал №1',
                description: 'Второй день был визионерским: студенты формировали видение идеального амбассадора и выявляли свои точки роста для приближения к этому образу.'
            })
        .column(style="flex: 1; background-color: var(--gray-color-4);")
            h4 Graduate Card
            +graduateCard({
                name: 'Константинопольский Константин',
                description: 'Здание находится на набережной реки Мойки напротив Юсуповского дворца, рядом с Центральным военно-морским музеем и Санкт-Петербургским Почтамтом.',
                icon: 'event-card-img'
            })
            +graduateCard({
                tag: 'a',
                name: 'Константинопольский Константин',
                description: 'Здание находится на набережной реки Мойки напротив Юсуповского дворца, рядом с Центральным военно-морским музеем и Санкт-Петербургским Почтамтом.',
                link: 'https://example.com',
                icon: 'event-card-img'
            })
        .column(style="flex: 1; background-color: var(--gray-color-2);")
            +textContent({
                content: `
                    <p>Из теории Гераклита, даже если она применима лишь к чувственным объектам, вытекает определение знания как восприятия и следует, что знание бывает о том, что находится в становлении, а не о том, что есть.</p>
                    <p>Из теории Гераклита, даже если она применима лишь к чувственным объектам, вытекает определение знания как восприятия и следует, <a href="">что знание бывает</a> о том, что находится в становлении, а не о том, что есть.</p>
                    <ul>
                        <li>Нам говорят, что поскольку 6 больше 4, но меньше 12,6 одновременно и велико и мало, что является противоречием.</li>
