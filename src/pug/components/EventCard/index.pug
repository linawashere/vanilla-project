include ../../components/Tag/index

mixin eventCard(props = {})
    -
        var {
            tag = 'div',
            title = 'Event Title',
            date = { day: '', month: '', year: '' },
            infoItems = [],
            tags = []
        } = props

        var eventDate = `${date.year}-${date.month}-${date.day}`;

        var attributes = {
            'data-event-date': eventDate,
        };

    #{tag}.event-card&attributes(attributes)
        .event-card__top.icon-event-card-img
            .event-card__button
                i.icon.icon-button-bookmark
            .event-card__date
                span= date.day
                span= date.month
        .event-card__content
            .event-card__header
                .event-card__header__top
                    if tags.length > 0
                        .event-card__tags
                            each tagData in tags
                                .event-card__tag
                                    +tag({ type: tagData.type, color: tagData.color })
                                        | #{tagData.label}
                    .event-card__timer
                        i.icon.icon-alarm-plus
                        span.event-card__timer-days
                h4.event-card__title= title
            .event-card__info
                each item in infoItems
                    div(class=`event-card__info-item event-card__info-item--${item.icon}`)
                        i.icon(class=`icon-${item.icon}`)
                        span= item.text