mixin alert(props={})
    -
        var {
            tag = 'div',
            type = null,
        } = props

    #{tag}.alert(class=type ? `alert__${type}` : null)&attributes(attributes)
        .alert__content
            if type
                i.icon-alert(class=`icon-${type}`)
            span.alert__text
                block
        button.alert__close(type='button')
            i.icon-close(class='icon-close')