mixin button(props={})
    -
        var {
            tag = 'button',
            contrast = false,
            outlined = false,
            isDisabled = false,
        } = props

    #{tag}.button(
        class=[{ 'button--disabled': isDisabled, _contrast: contrast, _outlined: outlined }]
    )&attributes(attributes)
        .button__inner
            span.button__text
                block
