include ../Icon/index

mixin flexButton(props={})
    -
        var {
            tag = 'button',
            iconNameLeft = null,
            iconNameRight = null,
            isDisabled = false,
            href =''
        } = props

    #{tag}.flex-button(
        class=[{ 'flex-button--disabled': isDisabled }]
        href=(tag === 'a' ? href : undefined)
    )&attributes(attributes)
        .flex-button__inner
            if iconNameLeft
                +icon(iconNameLeft)
            span.flex-button__text
                block
            if iconNameRight
                +icon(iconNameRight)