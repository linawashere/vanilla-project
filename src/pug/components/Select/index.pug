mixin select(props = {})
    -
        var {
            tag = 'div',
            options = [],
            placeholder = 'Выберите из списка',
            isDisabled = false,
            multi = false
        } = props

    #{tag}.select(
        class=[{
            'select__disabled': isDisabled
        }]
    )&attributes(attributes)
        .select__header
            span.select__label= placeholder
            i.icon.icon-right

        ul.select__options
            each option in options
                li.select__option
                    label(for=`option-${option.value}`)
                        input(
                            type=(multi ? 'checkbox' : 'radio'),
                            name="options",
                            value=option.value,
                            id=`option-${option.value}`
                        )
                        | #{option.label}